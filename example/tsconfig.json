{
  "extends": "../tsconfig",
  "compilerOptions": {
    // Declared here, not inherited: Metro reads this file to resolve the aliases
    // itself, so a stale babel transform cache cannot break the bundle.
    "paths": {
      "@salve-software/react-native-cicerone": ["../src/index"],
      "@/*": ["../src/*"],
      "~/*": ["./src/*"],
      "~storybook": ["./.storybook"]
    }
  }
}
